{
  "name": "heater-control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently 'pnpm dev:oidc' 'pnpm dev:web' 'pnpm dev:ha'",
    "dev:ha": "docker compose -f ha-dev/docker-compose.yml up",
    "dev:oidc": "pnpm --filter @heater-control/oidc-proxy dev",
    "dev:web": "pnpm --filter @heater-control/web dev",
    "lint": "eslint",
    "prepare": "husky",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.0.3",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "sort-package-json": "^3.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
  "engines": {
    "node": ">=24"
  }
}
