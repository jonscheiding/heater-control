# Public issuer URL of this proxy (must match what HA's auth_oidc discovers).
OIDC_ISSUER=https://sm-oidc.example.com
PORT=3300

# Stable JWKS (JSON). Generate once with `pnpm --filter @heater-control/oidc-proxy gen-keys`
# and store as a secret — do NOT regenerate per deploy or HA's cached keys break.
OIDC_JWKS={"keys":[]}

# Comma-separated secrets used to sign the provider's cookies (Keygrip rotation).
OIDC_COOKIE_KEYS=change-me-1,change-me-2

# Home Assistant auth_oidc client registration.
HA_CLIENT_ID=home-assistant
HA_CLIENT_SECRET=change-me
HA_REDIRECT_URIS=https://ha.example.com/auth/oidc/callback
# Match what hass-oidc-auth uses: client_secret_basic (default) or client_secret_post.
HA_TOKEN_AUTH_METHOD=client_secret_basic

# How long scraped claims stay cached during the auth flow (seconds).
ACCOUNT_TTL_SECONDS=600

# Passed through to @heater-control/sm-client; defaults to production.
# SM_BASE_URL=https://my.schedulemaster.com
