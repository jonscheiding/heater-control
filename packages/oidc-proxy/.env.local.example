# Local dev values for running the OIDC proxy ON THE HOST.
# Copy to .env.local, then fill OIDC_JWKS / OIDC_COOKIE_KEYS.
#
#   cp .env.local.example .env.local
#   pnpm --filter @heater-control/oidc-proxy gen-keys   # paste into OIDC_JWKS
#   pnpm --filter @heater-control/oidc-proxy dev
#
# The issuer must match what HA discovers. HA (in Docker) reaches the host proxy
# via `extra_hosts: oidc-proxy.test:host-gateway`; the browser reaches it via an
# /etc/hosts entry `127.0.0.1 oidc-proxy.test`. Both sides use the URL below.
OIDC_ISSUER=http://oidc-proxy.test:3000
PORT=3000

# Allow non-Secure cookies so the login flow works over plain http in dev.
OIDC_INSECURE_COOKIES=true

# Generate once with `gen-keys` (do not regenerate per run — HA caches the JWKS).
OIDC_JWKS={"keys":[]}
OIDC_COOKIE_KEYS=dev-cookie-1,dev-cookie-2

# HA client registration. HA_CLIENT_SECRET must equal the HA container's
# OIDC_CLIENT_SECRET (ha-dev/docker-compose.yml → dev-ha-secret).
HA_CLIENT_ID=home-assistant
HA_CLIENT_SECRET=dev-ha-secret
HA_REDIRECT_URIS=http://localhost:8123/auth/oidc/callback
HA_TOKEN_AUTH_METHOD=client_secret_basic

ACCOUNT_TTL_SECONDS=600
# Passed through to @heater-control/sm-client; defaults to production.
# SM_BASE_URL=https://my.schedulemaster.com
