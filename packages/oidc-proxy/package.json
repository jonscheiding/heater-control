{
  "name": "@heater-control/oidc-proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsx --watch --env-file-if-exists=.env.local src/server.ts",
    "gen-keys": "tsx scripts/gen-keys.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heater-control/sm-client": "workspace:*",
    "express": "^5.1.0",
    "jose": "^5.9.6",
    "nanoid": "^5.1.16",
    "oidc-provider": "^8.5.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/oidc-provider": "^8.5.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
