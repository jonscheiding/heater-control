# deploy toolkit config — copy to deploy/.env and fill in. deploy/.env is gitignored.

# --- Home Assistant target (REST) ---
HA_URL=https://your-ha-host             # no trailing slash
HA_TOKEN=                                # long-lived access token (Profile -> Security)

# --- SSH transport (rsync target: the SSH add-on) ---
# Local LAN while setting up; the box's Tailscale name/IP once deployed.
SSH_TARGET=root@homeassistant.local
SSH_PORT=22
# HA config dir as seen over SSH — the dir that already contains configuration.yaml.
# Varies by add-on: /root/config, /homeassistant, or /config. Confirm on the box:
#   ssh <SSH_TARGET> ls config/configuration.yaml
REMOTE_CONFIG=/root/config
# SSH_OPTS=-o StrictHostKeyChecking=accept-new -i ~/.ssh/haos

# --- OIDC / http includes (only needed for `push.sh --render-config`) ---
OIDC_DISCOVERY_URL=https://sm-oidc-proxy.example/.well-known/openid-configuration
OIDC_CLIENT_ID=home-assistant
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=ScheduleMaster
OIDC_FORCE_HTTPS=true
HA_CORS_ORIGINS=https://your-spa-domain
# Reverse-proxy trust: set BOTH together or neither (HA rejects a half-group).
# Leave the flag off for direct LAN / Tailscale access; turn it on and list the
# proxy CIDRs only when HA sits behind Nabu Casa / a reverse proxy.
HA_USE_X_FORWARDED_FOR=false
HA_TRUSTED_PROXIES=

# --- onboarding (bootstrap.sh only; the first-run owner account) ---
HA_ONBOARD_NAME=Admin
HA_ONBOARD_USERNAME=admin
HA_ONBOARD_PASSWORD=
HA_LATITUDE=44.9778
HA_LONGITUDE=-93.2650
HA_ELEVATION=265

# Pin override (normally leave unset; matches ha-dev/Dockerfile).
# AUTH_OIDC_VERSION=v1.1.1
