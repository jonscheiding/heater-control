# deploy toolkit config — copy to deploy/.env and fill in. deploy/.env is gitignored.
# push.sh ships packages/ + blueprints/ to the hand-provisioned HAOS box and reloads.

# --- Home Assistant (for the reload call) ---
HA_URL=https://your-ha-host             # no trailing slash
HA_TOKEN=                                # long-lived access token (Profile -> Security)

# --- SSH transport (rsync target: the SSH add-on) ---
# Local LAN while testing; the box's Tailscale name/IP once deployed.
SSH_TARGET=root@homeassistant.local
SSH_PORT=22
# HA config dir as seen over SSH — the dir that already contains configuration.yaml.
# Varies by add-on: /root/config, /homeassistant, or /config. Confirm on the box:
#   ssh <SSH_TARGET> ls config/configuration.yaml
REMOTE_CONFIG=/root/config
# SSH_OPTS=-o StrictHostKeyChecking=accept-new -i ~/.ssh/haos
