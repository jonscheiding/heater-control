# Home Assistant base URL (no trailing slash).
# Dev: http://localhost:8123 (HA Docker on the dev machine)
# Prod: your HA's public URL (Nabu Casa, reverse proxy, etc.)
VITE_HA_URL=http://localhost:8123

# Note: HA's OAuth2 flow uses the SPA's own origin as the client_id
# (with a trailing slash). It is derived from window.location at runtime,
# not configured here.
